# Local development
SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_NAME=we_learn_greek
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Production: set this instead of the DB_* vars above
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated frontend URLs for CORS (required when DEBUG=False)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app

# Comma-separated allowed hosts
# ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
