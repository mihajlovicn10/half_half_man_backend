# Copy this file to .env and paste your Neon connection string.
# Neon dashboard → Connection details → Pooled connection

SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# Paste your Neon connection string below (required for PostgreSQL):
DATABASE_URL=

# After saving, run:
#   chmod +x scripts/setup_neon.sh && ./scripts/setup_neon.sh
# Or manually:
#   python manage.py migrate
#   python manage.py createsuperuser
